{
  "rewrites": [
    {
      "source": "/api/admin/:route*",
      "destination": "/api/admin?route=:route*"
    },
    {
      "source": "/admin",
      "destination": "/"
    },
    { 
      "source": "/(.*)", 
      "destination": "/index.html" 
    }
  ],
  "functions": {
    "api/submit.ts": {
      "includeFiles": "api/email-template.html"
    }
  }
}