{
  "rewrites": [
    {
      "source": "/api/admin/:route*",
      "destination": "/api/admin?route=:route*"
    },
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/speakermanual",
      "destination": "/speakermanual.html"
    },
    {
      "source": "/volunteermanual",
      "destination": "/volunteermanual.html"
    },
    {
      "source": "/restaurants",
      "destination": "/restaurants.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/submit.ts": {
      "includeFiles": "api/email-template.html"
    }
  }
}